{
  "name": "conversational-clustering-demo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun tsc -b && bunx --bun vite build",
    "typecheck": "bunx --bun tsc -b --pretty false",
    "preview": "bunx --bun vite preview",
    "test": "bunx --bun vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^2.1.8"
  }
}
